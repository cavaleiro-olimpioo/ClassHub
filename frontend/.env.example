# URL base da API do backend (Spring Boot).
# Em producao o proprio Nginx faz o proxy de /api -> http://backend:8080,
# entao normalmente NAO e preciso alterar este valor.
VITE_API_BASE_URL=/api

# Alvo do proxy usado apenas pelo servidor de desenvolvimento (npm run dev).
VITE_DEV_API_TARGET=http://localhost:8080
